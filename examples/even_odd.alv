// জোড় না বিজোড়? (Even or odd?) — %, এবং, অথবা, না
ফাংশন জোড়(ন: সংখ্যা) -> সত্যমিথ্যা {
    ফেরত ন % ২ == ০
}

ফাংশন শুরু() {
    ধরি ন: সংখ্যা = ১
    যতক্ষণ (ন <= ৬) {
        যদি (জোড়(ন) এবং না (ন == ৪)) {
            দেখাও("জোড় সংখ্যা (৪ বাদে):")
            দেখাও(ন)
        }
        ন = ন + ১
    }
    দেখাও(জোড়(৭) অথবা জোড়(৮))
}
