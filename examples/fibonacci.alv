// ফিবোনাচি সংখ্যা (Fibonacci numbers)
ফাংশন ফিবোনাচি(এন: সংখ্যা) -> সংখ্যা {
    যদি (এন < ২) {
        ফেরত এন
    }
    ফেরত ফিবোনাচি(এন - ১) + ফিবোনাচি(এন - ২)
}

ফাংশন শুরু() {
    দেখাও("প্রথম ১০টি ফিবোনাচি সংখ্যা:")
    ধরি i: সংখ্যা = ০
    যতক্ষণ (i < ১০) {
        দেখাও(ফিবোনাচি(i))
        i = i + ১
    }
}
