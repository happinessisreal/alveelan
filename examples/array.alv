ফাংশন শুরু() {
    ধরি নাম: লেখা = "আলভীলান তালিকা পরীক্ষা"
    দেখাও(নাম)

    ধরি ক: তালিকা[সংখ্যা] = [১০, ২০, ৩০, ৪০, ৫০]
    
    দেখাও("তালিকার প্রথম সদস্য:")
    দেখাও(ক[০])
    
    দেখাও("তালিকার তৃতীয় সদস্য:")
    দেখাও(ক[২])
    
    দেখাও("মান পরিবর্তন করা হচ্ছে (ক[১] = ১০০)...")
    ক[১] = ১০০
    
    দেখাও("তালিকার দ্বিতীয় সদস্য এখন:")
    দেখাও(ক[১])

    ধরি খ: তালিকা[লেখা] = ["ক", "খ", "গ"]
    দেখাও("লেখা তালিকার শেষ সদস্য:")
    দেখাও(খ[২])
}
